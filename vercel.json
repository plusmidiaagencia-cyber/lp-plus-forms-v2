{
  "trailingSlash": true,
  "functions": {
    "api/diagnose.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/lpgpm/_next/image/",
      "destination": "https://lp-gpm-lpgpm.vercel.app/lpgpm/_next/image"
    },
    {
      "source": "/lpgpm/",
      "destination": "https://lp-gpm-lpgpm.vercel.app/lpgpm"
    },
    {
      "source": "/lpgpm/:path+",
      "destination": "https://lp-gpm-lpgpm.vercel.app/lpgpm/:path+"
    }
  ],
  "headers": [
    {
      "source": "/lpgpm/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/AIv1/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/aiv1",
      "destination": "/AIv1/",
      "permanent": false
    },
    {
      "source": "/aiv1/",
      "destination": "/AIv1/",
      "permanent": false
    }
  ]
}
